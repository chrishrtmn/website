---
import Base from '~/layouts/Base.astro';
import Hero from '~/components/Hero.astro';
import Work from '~/components/Work.astro';
import Ticker from '~/components/Ticker.astro';
import Experience from '~/components/Experience.astro';
import Now from '~/components/Now.astro';
import Events from '~/components/Events.astro';
import About from '~/components/About.astro';
import Footer from '~/components/Footer.astro';
import { disciplines, builtFor } from '~/content/brands';
---

<Base>
  <Hero />
  <Work />
  <Ticker
    label="What I work on, and brands I have built for"
    lines={[
      { name: 'what', items: disciplines, duration: 40 },
      { name: 'built for', items: builtFor, duration: 52, reverse: true, outline: true },
    ]}
  />
  <Experience />
  <Now />
  <Events />
  <About />
  <Footer slot="footer" />
</Base>
