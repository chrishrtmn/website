---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Footer from '~/components/Footer.astro';

const entries = (await getCollection('timeline')).map((t) => t.data).sort((a, b) => (a.date > b.date ? -1 : 1));
const kinds = [
  ['career', 'career'],
  ['project', 'projects'],
  ['event', 'events'],
  ['hearing', 'hearing tech'],
] as const;
const years = [...new Set(entries.map((e) => e.date.slice(0, 4)))];
const label = (d: string) => {
  const [y, m] = d.split('-');
  if (!m) return y;
  return new Date(Number(y), Number(m) - 1, 1).toLocaleString('en-US', { month: 'short' });
};
---

<Base title="Timeline" description="Random access memories: career moves, launches, events, and hearing tech, in order.">
  <section class="page wrap">
    <p class="label">timeline</p>
    <h1 class="page__title">Random access memories</h1>

    <fieldset class="filters small">
      <legend class="visually-hidden">Show</legend>
      {
        kinds.map(([k, l]) => (
          <label>
            <input type="checkbox" name="kind" value={k} checked={k !== 'hearing'} /> <span>{l}</span>
          </label>
        ))
      }
    </fieldset>

    <ol class="tl">
      {
        years.map((y) => (
          <li class="tl__year">
            <h2 class="tl__yearlabel">{y}</h2>
            <ol class="tl__items">
              {entries
                .filter((e) => e.date.startsWith(y))
                .map((e) => (
                  <li class="tl__item" data-kind={e.kind}>
                    <span class="tl__when mono">{label(e.date)}</span>
                    <span class="tl__kind small">{e.kind}</span>
                    <span class="tl__title">
                      {e.url ? (
                        <a href={e.url} target="_blank" rel="noopener">
                          {e.title} <span aria-hidden="true">↗</span>
                        </a>
                      ) : (
                        e.title
                      )}
                    </span>
                    {(e.detail || e.place) && <span class="tl__detail">{e.detail ?? e.place}</span>}
                  </li>
                ))}
            </ol>
          </li>
        ))
      }
    </ol>
  </section>
  <Footer slot="footer" />
</Base>

<script>
  const page = document.querySelector<HTMLElement>('.page');
  const boxes = [...document.querySelectorAll<HTMLInputElement>('input[name="kind"]')];
  const params = new URLSearchParams(location.search);
  const wanted = params.get('kind');
  if (wanted) for (const b of boxes) b.checked = b.value === wanted;

  const apply = () => {
    const on = new Set(boxes.filter((b) => b.checked).map((b) => b.value));
    page?.querySelectorAll<HTMLElement>('.tl__item').forEach((el) => {
      el.hidden = !on.has(el.dataset.kind ?? '');
    });
    page?.querySelectorAll<HTMLElement>('.tl__year').forEach((y) => {
      y.hidden = !y.querySelector('.tl__item:not([hidden])');
    });
  };
  boxes.forEach((b) => b.addEventListener('change', apply));
  apply();
</script>

<style>
  .page {
    padding-block: var(--s-24) var(--s-16);
  }

  .page__title {
    margin: var(--s-3) 0 var(--s-8);
    font-size: clamp(2.5rem, 7vw, 5rem);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: 0 0 var(--s-12);
    padding: 0;
    border: 0;
  }

  .filters label {
    position: relative;
    padding: 0.25em 0.8em;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--g);
    cursor: pointer;
  }

  .filters input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .filters label:has(:checked) {
    border-color: var(--neon);
    color: var(--w);
  }

  .filters label:has(:focus-visible) {
    outline: 2px solid var(--neon);
    outline-offset: 2px;
  }

  .tl,
  .tl__items {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tl__year {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: var(--s-6);
    padding-block: var(--s-6);
    border-top: 1px solid var(--line);
  }

  .tl__yearlabel {
    font-size: var(--text-2xl);
    color: var(--g);
  }

  .tl__item {
    display: grid;
    grid-template-columns: 3rem 5.5rem 1fr;
    gap: var(--s-1) var(--s-4);
    padding-block: var(--s-3);
  }

  .tl__item + .tl__item {
    border-top: 1px dashed var(--line);
  }

  .tl__when,
  .tl__kind {
    color: var(--g2);
    font-size: var(--text-xs);
    padding-top: 0.35em;
  }

  .tl__item[data-kind='project'] .tl__kind {
    color: var(--neon);
  }

  .tl__title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    line-height: 1.05;
  }

  .tl__title a {
    text-decoration: none;
  }

  .tl__title a:hover {
    color: var(--neon);
  }

  .tl__detail {
    grid-column: 3;
    color: var(--g);
    max-width: var(--measure);
  }

  @media (max-width: 700px) {
    .tl__year {
      grid-template-columns: 1fr;
      gap: var(--s-3);
    }
    .tl__item {
      grid-template-columns: 3rem 1fr;
    }
    .tl__kind {
      display: none;
    }
    .tl__detail {
      grid-column: 2;
    }
  }
</style>
