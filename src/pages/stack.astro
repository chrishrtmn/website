---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Footer from '~/components/Footer.astro';

const skills = (await getCollection('skills')).map((s) => s.data);
const groups = [
  ['languages', 'Languages'],
  ['frameworks', 'Frameworks'],
  ['platforms', 'Platforms'],
  ['design', 'Design'],
  ['tooling', 'Tooling'],
] as const;

const START = 2002;
const NOW = new Date().getFullYear();
const span = NOW - START + 1;
const pct = (y: number) => ((y - START) / span) * 100;
const decades = [2005, 2010, 2015, 2020, 2025];
---

<Base title="Stack" description="Languages, frameworks, platforms, and tools, by the years I used them.">
  <section class="page wrap">
    <p class="label">stack</p>
    <h1 class="page__title">What I've used, and when</h1>
    <p class="page__lede">Solid bars are professional use. Outlined bars are personal projects. The axis runs {START} to today.</p>

    <div class="axis mono" aria-hidden="true">
      {decades.map((d) => <span style={`left: ${pct(d)}%`}>{d}</span>)}
    </div>

    {
      groups.map(([key, title]) => (
        <section class="group" aria-labelledby={`g-${key}`}>
          <h2 id={`g-${key}`} class="group__title">
            {title}
          </h2>
          <ul class="bars">
            {skills
              .filter((s) => s.group === key)
              .sort((a, b) => a.start - b.start || a.id.localeCompare(b.id))
              .map((s) => (
                <li class="bar">
                  <span class="bar__name mono">{s.id}</span>
                  <span class="bar__track">
                    <span
                      class:list={['bar__fill', { 'bar__fill--personal': !s.professional }]}
                      style={`left: ${pct(s.start)}%; width: ${pct((s.end ?? NOW) + 1) - pct(s.start)}%`}
                      title={`${s.start} to ${s.end ?? 'now'}`}
                    />
                  </span>
                  <span class="bar__years mono">
                    {s.start}–{s.end ? String(s.end).slice(2) : ''}
                  </span>
                </li>
              ))}
          </ul>
        </section>
      ))
    }
  </section>
  <Footer slot="footer" />
</Base>

<style>
  .page {
    padding-block: var(--s-24) var(--s-16);
  }

  .page__title {
    margin: var(--s-3) 0 var(--s-4);
    font-size: clamp(2.5rem, 7vw, 5rem);
  }

  .page__lede {
    color: var(--g);
    margin-bottom: var(--s-12);
  }

  .axis {
    position: relative;
    height: 1.5rem;
    margin-left: 9rem;
    margin-right: 5rem;
    color: var(--g2);
    font-size: var(--text-xs);
  }

  .axis span {
    position: absolute;
    transform: translateX(-50%);
  }

  .group {
    margin-top: var(--s-8);
  }

  .group__title {
    margin-bottom: var(--s-3);
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-tight);
  }

  .bars {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .bar {
    display: grid;
    grid-template-columns: 9rem 1fr 5rem;
    align-items: center;
    gap: 0;
    padding-block: var(--s-2);
    border-bottom: 1px solid var(--line);
  }

  .bar__name {
    color: var(--w);
  }

  .bar__track {
    position: relative;
    height: 0.75rem;
    background: repeating-linear-gradient(90deg, transparent 0 calc(100% / 24 - 1px), var(--line) 0 calc(100% / 24));
  }

  .bar__fill {
    position: absolute;
    top: 0;
    bottom: 0;
    background: var(--neon);
  }

  .bar__fill--personal {
    background: transparent;
    border: 1px solid var(--neon);
  }

  .bar__years {
    text-align: right;
    color: var(--g);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 700px) {
    .axis {
      display: none;
    }
    .bar {
      grid-template-columns: 1fr 4rem;
      grid-template-areas: 'name years' 'track track';
      row-gap: var(--s-1);
    }
    .bar__name {
      grid-area: name;
    }
    .bar__years {
      grid-area: years;
    }
    .bar__track {
      grid-area: track;
    }
  }
</style>
