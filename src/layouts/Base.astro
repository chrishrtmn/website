---
import '~/styles/global.css';
import { site } from '~/lib/site';
import Header from '~/components/Header.astro';
import KitTray from '~/components/KitTray.astro';
import Top8 from '~/components/Top8.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const { title, description = site.description, ogImage } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, site.url).href;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site.url}/#person`,
  name: site.name,
  url: `${site.url}/`,
  email: `mailto:${site.email}`,
  jobTitle: 'Product Engineer',
  description: site.description,
  address: { '@type': 'PostalAddress', addressLocality: site.location.city, addressRegion: 'OH', addressCountry: 'US' },
  sameAs: [site.links.github, site.links.linkedin],
};
---

<!doctype html>
<html lang="en" data-motion="on">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#111210" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, site.url).href} />}
    {ogImage && <meta name="twitter:card" content="summary_large_image" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/schibsted-grotesk-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-mono.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/json" href="/resume.json" title="Résumé" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var on = true;
        try {
          var stored = localStorage.getItem('motion');
          on = stored ? stored === 'on' : !matchMedia('(prefers-reduced-motion: reduce)').matches;
        } catch (e) {}
        root.dataset.motion = on ? 'on' : 'off';
        if (!on) return;
        try {
          if (!sessionStorage.getItem('intro')) {
            sessionStorage.setItem('intro', '1');
            root.dataset.intro = 'play';
          }
        } catch (e) {
          root.dataset.intro = 'play';
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip visually-hidden" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
    <KitTray />
    <Top8 />
  </body>
</html>

<style>
  .skip:focus {
    position: fixed;
    inset: var(--s-4) auto auto var(--s-4);
    width: auto;
    height: auto;
    margin: 0;
    padding: var(--s-2) var(--s-4);
    clip-path: none;
    background: var(--neon);
    color: var(--neon-ink);
    font-family: var(--font-mono);
    z-index: var(--z-toast);
  }
</style>
