---
import '~/styles/global.css';
import { site } from '~/lib/site';
import Header from '~/components/Header.astro';
import KitTray from '~/components/KitTray.astro';
import Top8 from '~/components/Top8.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  hero?: boolean;
}

const { title, description = site.description, ogImage = '/og/home.png', ogType = 'website', hero = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, site.url).href;
const umamiId = import.meta.env.PROD ? import.meta.env.PUBLIC_UMAMI_ID : undefined;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site.url}/#person`,
  name: site.name,
  url: `${site.url}/`,
  email: `mailto:${site.email}`,
  jobTitle: 'Product Engineer',
  description: site.description,
  address: { '@type': 'PostalAddress', addressLocality: site.location.city, addressRegion: 'OH', addressCountry: 'US' },
  sameAs: [site.links.github, site.links.linkedin, ...site.social.map((s) => s.url)],
};
---

<!doctype html>
<html lang="en" data-motion="on" data-hero={hero ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#111210" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`OPE! ${site.name}, product engineer in northeast Ohio`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(ogImage, site.url).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/schibsted-grotesk-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-mono.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/json" href="/resume.json" title="Résumé" />
    <link rel="alternate" type="application/rss+xml" href="/rss.xml" title={`${site.name}, posts`} />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var on = true;
        try {
          var stored = localStorage.getItem('motion');
          on = stored ? stored === 'on' : !matchMedia('(prefers-reduced-motion: reduce)').matches;
        } catch (e) {}
        root.dataset.motion = on ? 'on' : 'off';
        if (!on || !root.hasAttribute('data-hero')) return;
        try {
          if (!sessionStorage.getItem('intro')) {
            sessionStorage.setItem('intro', '1');
            root.dataset.intro = 'play';
          }
        } catch (e) {
          root.dataset.intro = 'play';
        }
      })();
    </script>
    {umamiId && <script defer src="https://cloud.umami.is/script.js" data-website-id={umamiId} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip visually-hidden" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
    <KitTray />
    <Top8 />
    <script>
      import { UNLOCK_EVENT, UNLOCK_KEY } from '~/content/top8';
      import { site } from '~/lib/site';

      declare global {
        interface Window {
          ope: () => string;
        }
      }

      window.ope = () => {
        try {
          sessionStorage.setItem(UNLOCK_KEY, '1');
        } catch {}
        document.dispatchEvent(new CustomEvent(UNLOCK_EVENT));
        return 'ope.';
      };

      // in-page anchors scroll, then leave the URL clean so a reload stays where the reader is
      {
        let settle = 0;
        const clean = () => {
          clearTimeout(settle);
          settle = window.setTimeout(() => {
            if (location.hash) history.replaceState(history.state, '', location.pathname + location.search);
          }, 900);
        };
        if (location.hash) clean();
        addEventListener('hashchange', clean);
      }

      {
        const caution = 'background:#feff09;color:#0e0e01;font:700 32px/1 "Schibsted Grotesk",Helvetica,Arial,sans-serif;padding:12px 16px;letter-spacing:-0.02em';
        const mono = 'font:12px/1.6 "Geist Mono",ui-monospace,Menlo,monospace;color:#9a9c8f';
        const bright = 'font:12px/1.6 "Geist Mono",ui-monospace,Menlo,monospace;color:#f4f4f0';
        console.log('%cOPE!', caution);
        console.log('%cope. you found the console.', bright);
        console.log('%c↑ ↑ ↓ ↓ ← → ← → B A   on the page, or type ope() here.', mono);
        console.log(`%c${site.email} · ${site.links.github.replace('https://', '')}`, mono);
      }
    </script>
  </body>
</html>

<style>
  .skip:focus {
    position: fixed;
    inset: var(--s-4) auto auto var(--s-4);
    width: auto;
    height: auto;
    margin: 0;
    padding: var(--s-2) var(--s-4);
    clip-path: none;
    background: var(--neon);
    color: var(--neon-ink);
    font-family: var(--font-mono);
    z-index: var(--z-toast);
  }
</style>
