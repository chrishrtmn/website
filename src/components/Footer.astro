---
import { site } from '~/lib/site';

const year = new Date().getFullYear();
const talk = 'hey chat'.split('');
// letter-only position, so the stagger runs straight from Y to C without a slot for the space
const nth = (i: number) => talk.slice(0, i).filter((c) => c !== ' ').length;
const external = { target: '_blank', rel: 'noopener' } as const;
const handle = site.handle;
---

<footer class="footer on-neon" id="contact">
  <div class="footer__top wrap">
    <div class="footer__intro">
      <button type="button" class="footer__talk" aria-pressed="false" data-talk>
        <span class="visually-hidden">hey chat, in Latin or sign-language letters</span>
        {
          talk.map((ch, i) =>
            ch === ' ' ? (
              <span class="footer__space" aria-hidden="true" />
            ) : (
              <span class="footer__cell" aria-hidden="true" style={`--n: ${nth(i)}`}>
                <span class="footer__latin">{ch}</span>
                <span class="footer__sign">{ch}</span>
              </span>
            ),
          )
        }
      </button>
    </div>

    <nav class="footer__col" aria-labelledby="footer-talk">
      <p class="label" id="footer-talk">talk</p>
      <ul>
        <li><a href={`mailto:${site.email}`} data-umami-event="email">Email</a></li>
        <li><a href={site.links.github} {...external} rel="me noopener">GitHub<span class="ext" aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a></li>
        <li><a href={site.links.linkedin} {...external} rel="me noopener">LinkedIn<span class="ext" aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a></li>
        {
          site.social.map((s) => (
            <li>
              <a href={s.url} {...external} rel="me noopener">{s.network}<span class="ext" aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="footer__col" aria-labelledby="footer-site">
      <p class="label" id="footer-site">site</p>
      <ul>
        <li>
          <a href="/paparazzi/" data-kit-link>
            Paparazzi kit<svg class="ext ext--cam" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M5.5 3.5 4.6 5H2.5A1.5 1.5 0 0 0 1 6.5v6A1.5 1.5 0 0 0 2.5 14h11a1.5 1.5 0 0 0 1.5-1.5v-6A1.5 1.5 0 0 0 13.5 5h-2.1l-.9-1.5z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
              <circle class="cam__lens" cx="8" cy="9.25" r="2.6" stroke="currentColor" stroke-width="1.4" />
              <path class="cam__flash" d="M12.6 2.3V.9M14.3 3.2l1-1M14.9 5h1.4" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
            </svg>
          </a>
        </li>
        <li><a href="/rss.xml">RSS</a></li>
        <li><a href="/resume.json" {...external}>resume.json<span class="ext" aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a></li>
        <li><a href={site.links.source} {...external}>Source<span class="ext" aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a></li>
        <li><a href="/privacy/" data-privacy-link>Privacy</a></li>
      </ul>
    </nav>
  </div>

  <div class="footer__fine wrap mono">
    <span>© {year} Chris Hartman</span>
    <button type="button" class="footer__cheat" title="cheat code" data-cheat>
      <span class="visually-hidden" data-cheat-label>Up up down down left right left right B A</span>
      {
        ['up', 'up', 'down', 'down', 'left', 'right', 'left', 'right'].map((d, i) => (
          <svg class={`footer__key footer__key--${d}`} style={`--i: ${i}`} viewBox="0 0 10 10" width="10" height="10" aria-hidden="true">
            <path d="M2 6.5 5 3.5l3 3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        ))
      }
      <span style="--i: 8" aria-hidden="true">BA</span>
    </button>
  </div>

  <span class="footer__handle" aria-hidden="true"><span class="footer__at">@</span>{handle}</span>
</footer>

<script>
  import { UNLOCK_EVENT, UNLOCK_KEY } from '~/content/top8';

  // HEY CHAT: each letter blurs into its sign and back, on a timer while the footer is
  // on screen; hover or tap switches it now and holds it
  const talk = document.querySelector<HTMLButtonElement>('[data-talk]');
  if (talk) {
    const root = document.documentElement;
    const motionOn = () => root.dataset.motion !== 'off';
    const signed = () => talk.classList.contains('is-signed');
    const set = (on: boolean) => {
      talk.classList.toggle('is-signed', on);
      talk.setAttribute('aria-pressed', String(on));
    };

    const EVERY = 4000;
    let timer = 0;
    let held = false;
    let inView = false;
    const stop = () => {
      clearInterval(timer);
      timer = 0;
    };
    const start = () => {
      if (timer || held || !inView || !motionOn()) return;
      timer = window.setInterval(() => {
        if (!document.hidden) set(!signed());
      }, EVERY);
    };

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            inView = e.isIntersecting;
            if (inView) start();
            else stop();
          }
        },
        { threshold: 0.5 },
      ).observe(talk);
    }

    const fine = matchMedia('(hover: hover) and (pointer: fine)');
    talk.addEventListener('pointerenter', () => {
      if (!fine.matches) return;
      held = true;
      stop();
      set(!signed());
    });
    talk.addEventListener('pointerleave', () => {
      if (!fine.matches) return;
      held = false;
      start();
    });
    // touch and keyboard: a press switches it and pauses the timer; a second press resumes
    talk.addEventListener('click', (e) => {
      if (fine.matches && e.detail > 0) return;
      held = !held;
      if (held) {
        stop();
        set(!signed());
      } else start();
    });

    new MutationObserver(() => {
      if (motionOn()) start();
      else stop();
    }).observe(root, { attributes: true, attributeFilter: ['data-motion'] });
  }

  const cheat = document.querySelector<HTMLButtonElement>('[data-cheat]');
  if (cheat) {
    const unlocked = () => {
      try {
        return sessionStorage.getItem(UNLOCK_KEY) === '1';
      } catch {
        return false;
      }
    };
    const label = () => {
      const on = unlocked();
      cheat.title = on ? 'Open the Top 8' : 'cheat code';
      const text = cheat.querySelector('[data-cheat-label]');
      if (text) text.textContent = on ? 'Open the Top 8' : 'Up up down down left right left right B A';
    };
    label();
    document.addEventListener(UNLOCK_EVENT, label);
    cheat.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent(unlocked() ? UNLOCK_EVENT : 'command-menu:nope'));
    });

    // while locked: light the keys up in play order every so often, once the footer is on screen
    const motionOn = () => document.documentElement.dataset.motion !== 'off';
    let timer = 0;
    const nudge = () => {
      if (unlocked() || !motionOn() || cheat.matches(':hover, :focus-visible') || document.hidden) return;
      cheat.classList.remove('is-nudge');
      void cheat.offsetWidth;
      cheat.classList.add('is-nudge');
    };
    const stop = () => {
      clearInterval(timer);
      timer = 0;
      cheat.classList.remove('is-nudge');
    };
    const start = () => {
      if (timer || unlocked()) return;
      timer = window.setTimeout(() => {
        nudge();
        timer = window.setInterval(nudge, 5000);
      }, 1200);
    };
    document.addEventListener(UNLOCK_EVENT, stop);
    cheat.addEventListener('animationend', (e) => {
      if ((e.target as HTMLElement).style.getPropertyValue('--i') === '8') cheat.classList.remove('is-nudge');
    });
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => entries.forEach((e) => (e.isIntersecting ? start() : stop())), { threshold: 0.5 }).observe(cheat);
    } else {
      start();
    }
  }
</script>

<style>
  /* the page closes on a Caution slab, the handle running off the bottom edge */
  .footer {
    position: relative;
    overflow: hidden;
    background: var(--neon);
    color: var(--neon-ink);
  }

  /* wide: HEY CHAT and the two link columns share a row; narrower: HEY CHAT sits above them */
  .footer__top {
    display: grid;
    grid-template-columns: minmax(0, 2.2fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--s-12) clamp(var(--s-8), 4vw, var(--s-16));
    align-items: start;
    padding-block: var(--s-16) var(--s-12);
  }

  .footer__intro {
    min-width: 0;
  }

  /* HEY CHAT */
  .footer__talk {
    display: flex;
    flex-wrap: nowrap;
    align-items: flex-end;
    max-width: none;
    margin: 0;
    text-align: left;
    /* side by side the column is ~52% of the content width; 7.4vw keeps the line inside it */
    font-size: min(7.4vw, 9rem);
    white-space: nowrap;
    line-height: 1;
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    -webkit-tap-highlight-color: transparent;
  }

  .footer__talk:focus-visible {
    outline: 2px solid var(--neon-ink);
    outline-offset: 0.08em;
  }

  .footer__space {
    width: 0.28em;
  }

  /* blur morph: the letter blurs and shrinks out while the hand blurs in from slightly larger,
     so mid-transition they read as one soft shape changing */
  .footer__cell {
    display: grid;
  }

  /* the blur clears before the fade ends and the hands never scale, so their line weight is
     fixed by the time they are fully visible; own layers keep them from re-rasterising at the end */
  .footer__latin,
  .footer__sign {
    grid-area: 1 / 1;
    transition:
      opacity 700ms var(--ease-out),
      filter 420ms var(--ease-out),
      transform 700ms var(--ease-out);
    transition-delay: calc(var(--n) * 90ms);
    will-change: opacity, filter, transform;
  }

  /* outline letters, the same treatment as the "built for" ticker line */
  .footer__latin {
    font-family: var(--font-display);
    font-weight: 700;
    color: transparent;
    -webkit-text-stroke: 0.02em var(--neon-ink);
  }

  .footer__sign {
    justify-self: center;
    font-family: var(--font-sign);
    font-weight: 400;
    letter-spacing: 0;
    text-transform: lowercase;
    /* the hand glyphs sit on the baseline; lift them so their middle lines up with the capitals */
    --lift: -0.075em;
    opacity: 0;
    filter: blur(0.08em);
    transform: translateY(var(--lift));
  }

  .footer__talk.is-signed .footer__latin {
    opacity: 0;
    filter: blur(0.08em);
    transform: scale(0.9);
  }

  .footer__talk.is-signed .footer__sign {
    opacity: 1;
    filter: blur(0);
    transform: translateY(var(--lift));
  }

  /* motion off: faces swap in place, no blur */
  :global(html[data-motion='off']) .footer__latin,
  :global(html[data-motion='off']) .footer__sign {
    transition: none;
    filter: none;
  }

  :global(html[data-motion='off']) .footer__latin {
    transform: none;
  }

  :global(html[data-motion='off']) .footer__sign {
    transform: translateY(var(--lift));
  }

  /* link columns */
  .footer__col .label {
    margin: 0 0 var(--s-3);
    padding-bottom: var(--s-2);
    border-bottom: 2px solid var(--neon-ink);
    color: var(--neon-dim);
  }

  .footer__col ul {
    display: grid;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* plain inline, so the hover underline stays on the words; the inline-block arrows don't inherit it */
  .footer__col a {
    font-weight: 500;
    text-decoration: none;
    color: var(--neon-ink);
  }

  .footer__col a:hover,
  .footer__col a:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .footer :focus-visible {
    outline-color: var(--neon-ink);
  }

  .ext {
    display: inline-block;
    margin-inline-start: 0.2em;
    font-size: 0.75em;
    text-decoration: none;
    color: var(--neon-dim);
    transition: color var(--dur-1) var(--ease-out), transform var(--dur-1) var(--ease-out);
  }

  .footer__col a:hover .ext,
  .footer__col a:focus-visible .ext {
    color: var(--neon-ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .footer__col a:hover .ext {
      transform: translate(2px, -2px);
    }
  }

  /* the camera body fills the lower two-thirds of its box (the flash rays sit above),
     so lift it until the body is centred on the capitals */
  .ext--cam {
    width: 1em;
    height: 1em;
    vertical-align: 0.02em;
    overflow: visible;
  }

  /* camera flash: the lens pops and three rays burst once per hover */
  .cam__lens {
    fill: transparent;
  }

  .cam__flash {
    opacity: 0;
    transform-box: view-box;
    transform-origin: 12.6px 4.6px;
  }

  @media (hover: hover) and (pointer: fine) {
    .footer__col a:hover .cam__lens {
      animation: cam-lens 600ms var(--ease-out);
    }
    .footer__col a:hover .cam__flash {
      animation: cam-flash 600ms var(--ease-out);
    }
  }

  .footer__col a:focus-visible .cam__lens {
    animation: cam-lens 600ms var(--ease-out);
  }

  .footer__col a:focus-visible .cam__flash {
    animation: cam-flash 600ms var(--ease-out);
  }

  /* three quick pops, like a burst shot */
  @keyframes cam-lens {
    0%, 12%, 30%, 45%, 63%, 78%, 96%, 100% {
      fill: transparent;
    }
    5%, 38%, 71% {
      fill: currentColor;
    }
  }

  @keyframes cam-flash {
    0%, 33%, 66% {
      opacity: 0;
      transform: scale(0.6);
    }
    6%, 39%, 72% {
      opacity: 1;
    }
    30%, 63%, 96%, 100% {
      opacity: 0;
      transform: scale(1.2);
    }
  }

  /* motion off: the lens still blinks, the rays stay put */
  :global(html[data-motion='off']) .cam__flash {
    animation: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .cam__flash {
      animation: none !important;
    }
  }

  /* fine print */
  .footer__fine {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2) var(--s-6);
    padding-block: var(--s-4);
    border-top: 2px solid var(--neon-ink);
    color: var(--neon-dim);
  }

  .footer__cheat {
    display: inline-flex;
    align-items: center;
    gap: 0.15em;
    padding: 0.2em 0.6em;
    border: 1px solid var(--neon-dim);
    border-radius: 999px;
    color: var(--neon-dim);
    font: inherit;
    letter-spacing: 0.08em;
    transition: color var(--dur-1) var(--ease-out), border-color var(--dur-1) var(--ease-out);
  }

  .footer__cheat span:not(.visually-hidden) {
    margin-inline-start: 0.3em;
  }

  .footer__key {
    display: block;
    width: 0.7em;
    height: 0.7em;
    flex: none;
  }

  .footer__key--down {
    transform: rotate(180deg);
  }

  .footer__key--left {
    transform: rotate(-90deg);
  }

  .footer__key--right {
    transform: rotate(90deg);
  }

  .footer__cheat:hover {
    color: var(--neon-ink);
    border-color: var(--neon-ink);
  }

  /* the code needs arrow keys; no pill where there are none */
  @media (hover: none), (pointer: coarse) {
    .footer__cheat {
      display: none;
    }
  }

  /* locked hint: each key pops up in ink in play order, like it's being pressed, then settles;
     the pill's outline darkens for the run so the eye finds it */
  :global(html[data-motion='on']) .footer__cheat.is-nudge > :not(.visually-hidden) {
    animation: key-hint 520ms var(--ease-out) calc(var(--i) * 90ms) both;
  }

  :global(html[data-motion='on']) .footer__cheat.is-nudge {
    animation: pill-hint 1360ms var(--ease-out);
  }

  @keyframes key-hint {
    0% {
      color: var(--neon-dim);
      translate: 0 0;
    }
    25% {
      color: var(--neon-ink);
      translate: 0 -0.22em;
    }
    100% {
      color: var(--neon-dim);
      translate: 0 0;
    }
  }

  @keyframes pill-hint {
    0%,
    100% {
      border-color: var(--neon-dim);
    }
    15%,
    80% {
      border-color: var(--neon-ink);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    @keyframes key-hint {
      0%,
      100% {
        color: var(--neon-dim);
      }
      25% {
        color: var(--neon-ink);
      }
    }
  }

  /* the handle, cropped by the bottom of the page; decorative, the links above are the real ones */
  .footer__handle {
    display: block;
    margin: var(--s-4) 0 -3.9vw -0.9vw;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 17.5vw;
    line-height: 0.78;
    letter-spacing: -0.065em;
    white-space: nowrap;
    color: var(--neon-ink);
    pointer-events: none;
    user-select: none;
  }

  .footer__at {
    letter-spacing: -0.02em;
  }

  @media (max-width: 1100px) {
    .footer__top {
      grid-template-columns: 1fr 1fr;
      gap: var(--s-8) var(--s-6);
    }
    .footer__intro {
      grid-column: 1 / -1;
    }
    .footer__talk {
      font-size: min(14.5vw, 9rem);
    }
  }
</style>
