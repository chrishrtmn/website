---
// Camera-flash overlay. Parent toggles `is-flashing` on itself; motion on only.
interface Props {
  delay?: number;
}
const { delay = 360 } = Astro.props;
---

<div class="flashes" aria-hidden="true" style={`--lead: ${delay}ms`}>
  <b class="flashes__bump"></b>
  <i style="--x: 14%; --y: 22%; --d: 0ms; --s: 1"></i>
  <i style="--x: 82%; --y: 30%; --d: 380ms; --s: 1.3"></i>
  <i style="--x: 36%; --y: 72%; --d: 760ms; --s: 0.9"></i>
  <i style="--x: 68%; --y: 56%; --d: 1120ms; --s: 1.15"></i>
  <i style="--x: 50%; --y: 16%; --d: 1500ms; --s: 1.4"></i>
  <i style="--x: 22%; --y: 86%; --d: 1900ms; --s: 0.8"></i>
</div>

<style>
  .flashes {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    overflow: hidden;
  }

  .flashes i {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 36vmin;
    height: 36vmin;
    margin: -18vmin 0 0 -18vmin;
    border-radius: 50%;
    background: radial-gradient(circle, #fff 0%, #fff 12%, rgba(255, 255, 255, 0.7) 26%, rgba(243, 241, 238, 0) 62%);
    opacity: 0;
    transform: scale(0.5);
    mix-blend-mode: screen;
  }

  .flashes__bump {
    position: absolute;
    inset: 0;
    background: #fff;
    opacity: 0;
  }

  :global(html[data-motion='on'] .is-flashing) .flashes i {
    animation: flash 900ms var(--ease-out) calc(var(--lead) + var(--d)) both;
  }

  :global(html[data-motion='on'] .is-flashing) .flashes .flashes__bump {
    animation: bump 2400ms linear var(--lead) both;
  }

  @keyframes flash {
    0% {
      opacity: 0;
      transform: scale(0.5);
    }
    6% {
      opacity: 1;
      transform: scale(var(--s));
    }
    22% {
      opacity: 0.9;
    }
    100% {
      opacity: 0;
      transform: scale(calc(var(--s) * 1.3));
    }
  }

  /* whole-surface bumps on the 1st, 2nd and 5th pops */
  @keyframes bump {
    0%,
    100% {
      opacity: 0;
    }
    1% {
      opacity: 0.22;
    }
    6% {
      opacity: 0;
    }
    16% {
      opacity: 0;
    }
    17% {
      opacity: 0.16;
    }
    22% {
      opacity: 0;
    }
    62% {
      opacity: 0;
    }
    63% {
      opacity: 0.26;
    }
    70% {
      opacity: 0;
    }
  }
</style>
