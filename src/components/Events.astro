---
import { getCollection } from 'astro:content';
import Section from './Section.astro';

const events = (await getCollection('timeline'))
  .map((t) => t.data)
  .filter((t) => t.kind === 'event')
  .sort((a, b) => (a.date > b.date ? -1 : 1));
---

<Section id="events" label="events" tight>
  <ul class="tickets">
    {
      events.map((e, i) => (
        <li class="ticket" style={`--i: ${i}`}>
          <span class="ticket__stub mono" aria-hidden="true">
            <span>admit</span>
            <span>one</span>
          </span>
          <span class="ticket__body">
            <span class="ticket__year mono">{e.date.slice(0, 4)}</span>
            <span class="ticket__title">{e.title}</span>
            <span class="ticket__place mono">{e.place}</span>
          </span>
        </li>
      ))
    }
  </ul>
</Section>

<script>
  const list = document.querySelector<HTMLElement>('.tickets');
  if (list && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            list.classList.add('is-in');
            io.disconnect();
          }
        }
      },
      { threshold: 0.3 },
    );
    io.observe(list);
  } else {
    list?.classList.add('is-in');
  }
</script>

<style>
  .tickets {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ticket {
    --notch: 0.5rem;
    position: relative;
    display: flex;
    background: var(--k2);
    border: 1px solid var(--line);
    mask:
      radial-gradient(circle at 0 50%, transparent var(--notch), #000 calc(var(--notch) + 0.5px)),
      radial-gradient(circle at 100% 50%, transparent var(--notch), #000 calc(var(--notch) + 0.5px));
    mask-composite: intersect;
    opacity: 0;
    transform: translateY(12px) rotate(-3deg);
  }

  :global(html[data-motion='on']) .tickets.is-in .ticket {
    animation: deal var(--dur-3) var(--ease-out) calc(var(--i) * 40ms) both;
  }

  :global(html[data-motion='off']) .ticket,
  .tickets.is-in .ticket {
    opacity: 1;
    transform: none;
  }

  @keyframes deal {
    from {
      opacity: 0;
      transform: translateY(12px) rotate(-3deg);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .ticket__stub {
    display: grid;
    align-content: center;
    gap: 0.1em;
    padding: var(--s-3) var(--s-3) var(--s-3) calc(var(--s-3) + var(--notch));
    border-right: 1px dashed var(--line);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--g2);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    transition: transform var(--dur-2) var(--ease-out), opacity var(--dur-2) var(--ease-out);
  }

  .ticket__body {
    display: grid;
    gap: var(--s-1);
    min-width: 9rem;
    padding: var(--s-3) calc(var(--s-4) + var(--notch)) var(--s-3) var(--s-4);
    transition: transform var(--dur-2) var(--ease-out);
  }

  .ticket__year {
    color: var(--g);
  }

  .ticket__title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    line-height: 1.05;
  }

  .ticket__place {
    color: var(--g2);
    font-size: var(--text-xs);
  }

  @media (hover: hover) and (pointer: fine) {
    .ticket:hover .ticket__stub {
      transform: rotate(180deg) translateY(4px) rotate(6deg);
      opacity: 0.6;
    }
    .ticket:hover .ticket__body {
      transform: translate(2px, -3px);
    }
  }
</style>
