---
import { getCollection } from 'astro:content';
import Section from './Section.astro';

const rows = (await getCollection('experience')).map((e) => e.data).sort((a, b) => b.start - a.start);
const span = (s: number, e?: number) => `${s}–${e ? String(e).slice(2) : ''}`;
---

<Section id="experience" label="experience" title="The résumé part">
  <dl class="xp">
    {
      rows.map((r) => (
        <div class="xp__row">
          <dt class="xp__years mono">{span(r.start, r.end)}</dt>
          <dd class="xp__body">
            <span class="xp__employer">
              {r.url ? (
                <a href={r.url} target="_blank" rel={r.noreferrer ? 'noopener noreferrer' : 'noopener'} referrerpolicy={r.noreferrer ? 'no-referrer' : undefined}>
                  {r.employer.split(' ').slice(0, -1).join(' ')}{' '}
                  <span class="xp__last">
                    {r.employer.split(' ').at(-1)}<span class="xp__ext" aria-hidden="true">↗</span>
                  </span>
                </a>
              ) : (
                r.employer
              )}
            </span>
            <span class="xp__titles small">{r.titles.join(' · ')}</span>
            <details class="xp__more" open>
              <summary class="small">what I did</summary>
              <span class="xp__scope">{r.scope}</span>
            </details>
          </dd>
        </div>
      ))
    }
  </dl>
</Section>

<script>
  const mq = matchMedia('(max-width: 600px)');
  const items = document.querySelectorAll<HTMLDetailsElement>('.xp__more');
  const apply = () => items.forEach((d) => (d.open = !mq.matches));
  apply();
  mq.addEventListener('change', apply);
</script>

<style>
  .xp {
    margin: 0;
    border-top: 1px solid var(--line);
  }

  .xp__row:last-child {
    border-bottom: 0;
  }

  .xp__row {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: var(--s-6);
    padding-block: var(--s-6);
    border-bottom: 1px solid var(--line);
  }

  .xp__years {
    color: var(--g);
    font-variant-numeric: tabular-nums;
  }

  .xp__body {
    display: grid;
    gap: var(--s-2);
    margin: 0;
  }

  .xp__employer {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    line-height: 1;
  }

  .xp__employer a {
    text-decoration: none;
  }

  .xp__employer a:hover,
  .xp__employer a:focus-visible {
    color: var(--neon);
  }

  .xp__last {
    white-space: nowrap;
  }

  .xp__ext {
    margin-inline-start: 0.2em;
    font-family: var(--font-sans);
    font-size: 0.6em;
    vertical-align: 0.35em;
    color: var(--g);
    transition: color var(--dur-1) var(--ease-out);
  }

  .xp__employer a:hover .xp__ext,
  .xp__employer a:focus-visible .xp__ext {
    color: inherit;
  }

  .xp__titles {
    color: var(--g);
  }

  .xp__scope {
    max-width: var(--measure);
    color: var(--w);
  }

  .xp__more summary {
    display: none;
  }

  .xp__more summary::-webkit-details-marker {
    display: none;
  }

  .xp__scope {
    display: block;
  }

  @media (max-width: 600px) {
    .xp__row {
      grid-template-columns: 1fr;
      gap: var(--s-2);
      padding-block: var(--s-4);
    }
    .xp__more summary {
      display: inline-block;
      cursor: pointer;
      color: var(--g);
      text-decoration: underline;
      text-underline-offset: 3px;
      text-decoration-color: var(--line);
      list-style: none;
    }
    .xp__more[open] summary {
      color: var(--g2);
    }
    .xp__more[open] .xp__scope {
      margin-top: var(--s-2);
    }
  }
</style>
