---
import { getCollection } from 'astro:content';
import Section from './Section.astro';

interface Row {
  when: string;
  title: string;
  url?: string;
  noreferrer?: boolean;
  sub?: string;
  detail?: string;
  highlights?: string[];
  type?: string;
  current?: boolean;
}

const mon = (m: number) => new Date(2000, m - 1, 1).toLocaleString('en-US', { month: 'short' });
const span = (s: number, sm: number, e?: number, em?: number) =>
  `${mon(sm)} ${s} – ${e && em ? `${mon(em)} ${e}` : 'now'}`;

const jobs = (await getCollection('experience'))
  .map((e) => e.data)
  .sort((a, b) => b.start * 12 + b.startMonth - (a.start * 12 + a.startMonth));

const rows: Row[] = jobs.map((r) => ({
  when: span(r.start, r.startMonth, r.end, r.endMonth),
  title: r.employer,
  url: r.url,
  noreferrer: r.noreferrer,
  sub: r.titles.join(' · '),
  detail: r.scope,
  highlights: r.highlights,
  type: r.type,
  current: !r.end,
}));

const dss = jobs.find((j) => j.employer === 'Double Slash Studios');
const studioMail = `mailto:hello@doubleslashstudios.com?subject=${encodeURIComponent('Project enquiry via chrishrtmn.com')}&body=${encodeURIComponent("Hi Chris,\n\nI found you through chrishrtmn.com and I'm interested in working with Double Slash Studios.\n\nWhat we need:\n\nTimeline:\n\nBudget:\n")}`;
---

<Section id="work" label="work" title="Random access memories">
  <label class="xp__toggle small" slot="head">
    <input type="checkbox" id="xp-details" aria-controls="xp-list" /> <span>show details</span>
  </label>

  <dl class="xp" id="xp-list">
    {
      rows.map((r) => (
        <div class="xp__row" data-current={r.current ? '' : undefined}>
          <dt class="xp__years mono">{r.when}</dt>
          <dd class="xp__body">
            <span class="xp__employer">
              {r.url ? (
                <a href={r.url} target="_blank" rel={r.noreferrer ? 'noopener noreferrer' : 'noopener'} referrerpolicy={r.noreferrer ? 'no-referrer' : undefined}>
                  {r.title.split(' ').slice(0, -1).join(' ')}{r.title.includes(' ') ? ' ' : ''}
                  <span class="xp__last">
                    {r.title.split(' ').at(-1)}<span class="xp__ext" aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span>
                  </span>
                </a>
              ) : (
                r.title
              )}
            </span>
            {(r.sub || r.type) && (
              <span class="xp__titles small">
                {r.sub}
                {r.type && (
                  <span class="xp__type">
                    {r.type.split(' → ').map((t, i) => (
                      <>
                        {i > 0 && (
                          <>
                            <span aria-hidden="true"> → </span>
                            <span class="visually-hidden"> then </span>
                          </>
                        )}
                        {t}
                      </>
                    ))}
                  </span>
                )}
              </span>
            )}
            {r.detail && <span class="xp__scope">{r.detail}</span>}
            {r.highlights && (
              <ul class="xp__wins">
                {r.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            )}
            {r.title === dss?.employer && (
              <p class="xp__lede">
                <span>
                  <a href={dss?.url} target="_blank" rel="noopener">Double Slash Studios<span class="xp__lede-ext" aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a> takes on builds, audits, integrations and AI tooling.
                </span>
                <a class="xp__email small" href={studioMail} data-umami-event="studio-email">Email works</a>
              </p>
            )}
          </dd>
        </div>
      ))
    }
  </dl>
</Section>

<style>
  .xp__lede {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-4);
    margin: var(--s-3) 0 0;
    color: var(--g);
  }

  .xp__lede > span a {
    color: var(--w);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .xp__lede > span a:hover,
  .xp__lede > span a:focus-visible {
    color: var(--neon);
  }

  .xp__lede-ext {
    display: inline-block;
    margin-inline-start: 0.15em;
    font-size: 0.75em;
    vertical-align: 0.2em;
    text-decoration: none;
    color: var(--g);
  }

  .xp__email {
    padding: 0.25em 0.8em;
    border: 1px solid var(--neon);
    border-radius: 999px;
    color: var(--w);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--dur-1) var(--ease-out), color var(--dur-1) var(--ease-out);
  }

  .xp__email:hover,
  .xp__email:focus-visible {
    background: var(--neon);
    color: var(--neon-ink);
  }

  .xp {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  .xp__row {
    display: grid;
    grid-template-columns: 10.5rem 1fr;
    gap: var(--s-6);
    padding-block: var(--s-6);
    border-top: 1px solid var(--line);
  }

  .xp__row[data-current] .xp__years {
    color: var(--neon);
  }

  .xp__years {
    color: var(--g);
    font-variant-numeric: tabular-nums;
  }

  .xp__body {
    display: grid;
    gap: var(--s-2);
    margin: 0;
  }

  .xp__employer {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    line-height: 1;
  }

  .xp__employer a {
    text-decoration: none;
  }

  .xp__employer a:hover,
  .xp__employer a:focus-visible {
    color: var(--neon);
  }

  .xp__last {
    white-space: nowrap;
  }

  .xp__ext {
    display: inline-block;
    text-decoration: none;
    margin-inline-start: 0.2em;
    font-family: var(--font-sans);
    font-size: 0.6em;
    vertical-align: 0.35em;
    color: var(--g);
    transition: color var(--dur-1) var(--ease-out), transform var(--dur-1) var(--ease-out);
  }

  .xp__employer a:hover .xp__ext,
  .xp__employer a:focus-visible .xp__ext {
    color: inherit;
  }

  /* same nudge as the Receipts arrow, pointer devices only */
  @media (hover: hover) and (pointer: fine) {
    .xp__employer a:hover .xp__ext {
      transform: translate(2px, -2px);
    }
  }

  .xp__titles {
    color: var(--g);
  }

  .xp__type {
    display: inline-block;
    margin-inline-start: var(--s-2);
    padding: 0.1em 0.5em;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: var(--text-xs);
    line-height: 1.6;
    white-space: nowrap;
  }

  .xp__scope {
    display: block;
    max-width: var(--measure);
    color: var(--w);
  }

  .xp__toggle {
    position: relative;
    padding: 0.25em 0.8em;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--g);
    cursor: pointer;
  }

  .xp__toggle input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .xp__toggle:has(:checked) {
    border-color: var(--neon);
    color: var(--w);
  }

  .xp__toggle:has(:focus-visible) {
    outline: 2px solid var(--neon);
    outline-offset: 2px;
  }

  /* bullets stay collapsed until "show details" is on; CSS only, so it works before any script */
  .xp__wins {
    display: none;
  }

  :global(.section:has(#xp-details:checked)) .xp__wins {
    display: grid;
    gap: var(--s-1);
    max-width: var(--measure);
    margin: var(--s-3) 0 0;
    padding-left: 1.1em;
    color: var(--g);
  }

  .xp__wins li::marker {
    color: var(--neon);
  }

  @media (max-width: 600px) {
    .xp__row {
      grid-template-columns: 1fr;
      gap: var(--s-2);
      padding-block: var(--s-4);
    }
    .xp__scope {
      margin-top: var(--s-1);
    }
  }
</style>
