---
import { nav, site } from '~/lib/site';
import { buildCommands } from '~/lib/commands';
import MotionToggle from '~/islands/MotionToggle';
import CommandMenu from '~/islands/CommandMenu';
import Wordmark from './Wordmark.astro';

const commands = await buildCommands();

const path = Astro.url.pathname;
---

<header class="header wrap">
  <Wordmark />
  <nav aria-label="Primary">
    <ul class="mono">
      {
        nav.map((item) => (
          <li>
            <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <MotionToggle client:load />
  <CommandMenu client:idle commands={commands} email={site.email} />
</header>

<style>
  .header {
    position: absolute;
    inset: 0 36% auto 0;
    z-index: var(--z-menu);
    display: flex;
    align-items: center;
    gap: var(--s-6);
    padding-block: var(--s-4);
    color: var(--g);
  }

  nav {
    margin-inline-start: auto;
  }

  ul {
    display: flex;
    gap: var(--s-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    text-decoration: none;
    transition: color var(--dur-1) var(--ease-out);
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--w);
  }

  @media (max-width: 900px) {
    .header {
      inset-inline-end: 0;
    }
  }

  @media (max-width: 600px) {
    ul {
      gap: var(--s-3);
    }
  }
</style>
