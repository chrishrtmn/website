---
import Section from './Section.astro';
import { kitHeadshot } from '~/lib/kit';
---

<Section id="about" label="about" title="Facts, no cap">
  <div class="about__text">
    <figure class="about__stamp">
      <picture>
        <source type="image/webp" srcset={`${kitHeadshot.webp2} 400w, ${kitHeadshot.webp1} 200w`} sizes="(max-width: 600px) 6rem, 13rem" />
        <img src={kitHeadshot.jpg} width="500" height="500" alt="Chris Hartman" loading="lazy" decoding="async" />
      </picture>
    </figure>
    <p class="about__lede">
      I'm Chris. I taught myself HTML and CSS by breaking MySpace layouts in 2005 and never really stopped. Over
      fifteen years later I build products for a living and more of them for fun: apps, websites, and lately a lot of
      AI tooling, from northeast Ohio.
    </p>
    <p class="about__body">
      Most of my spare hours go to designing and building products; the ones on the homepage, plus whatever I'm taking
      apart in the homelab that week. I've been working in VR and XR environments a lot lately, enough that
      <strong>some of what I build next will be spatial</strong>. Away from a screen you'll find me at a
      music festival or a Guardians game, hosting a game night, or hiking Hocking Hills. I also say "ope" more than is
      strictly necessary.
    </p>
  </div>
</Section>

<style>
  /* magazine wrap: the stamp floats left and both paragraphs run around it, then return to full width below */
  .about__text {
    display: flow-root;
  }

  .about__stamp {
    float: left;
    width: clamp(6.5rem, 22vw, 13rem);
    aspect-ratio: 1;
    margin: 0.35em var(--s-6) var(--s-4) 0;
    border: 2px solid var(--neon);
    outline: 1px solid var(--line);
    outline-offset: 6px;
    overflow: hidden;
    background: var(--k2);
    /* the text follows the outer edge of the outline, not the image box */
    shape-outside: inset(-7px round 0);
    shape-margin: var(--s-4);
  }

  .about__stamp img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about__text p {
    max-width: none;
  }

  .about__lede {
    margin: 0 0 var(--s-8);
    font-size: clamp(var(--text-xl), 3.2vw, var(--text-3xl));
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    line-height: 1.2;
    color: var(--w);
    text-wrap: pretty;
  }

  .about__body {
    margin: 0;
    font-size: clamp(var(--text-lg), 2.1vw, var(--text-2xl));
    line-height: 1.4;
    color: var(--g);
    text-wrap: pretty;
  }

  .about__body strong {
    color: var(--w);
    font-weight: 500;
  }

  @media (max-width: 600px) {
    .about__lede {
      margin-bottom: var(--s-6);
      font-size: var(--text-lg);
    }
    .about__body {
      font-size: var(--text-base);
    }
    .about__stamp {
      width: 6rem;
      margin: 0.3em var(--s-4) var(--s-2) 0;
      outline-offset: 4px;
      shape-outside: inset(-5px round 0);
      shape-margin: var(--s-3);
    }
  }
</style>
