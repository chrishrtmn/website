---
const facts = [
  ['coffee', 'chai latte (hot)'],
  ['music', 'metal, electronic'],
  ['movies', 'horror, comedy'],
  ['game', 'legend of zelda: ocarina of time'],
] as const;
---

<section id="about" class="about wrap" aria-labelledby="about-label">
  <p id="about-label" class="about__label label">about</p>

  <div class="about__text">
    <p class="about__lede">
      I'm Chris. I taught myself HTML and CSS by breaking MySpace layouts in 2005 and never really stopped. Over
      fifteen years later I build products for a living and more of them for fun: apps, websites, and lately a lot of
      AI tooling, from northeast Ohio.
    </p>
    <p class="about__body">
      Most of my spare hours go to designing and building products; the ones on the homepage, plus whatever I'm taking
      apart in the homelab that week. I've been working in VR and XR environments a lot lately, enough that
      <strong>spatial computing is the next thing I want to build for</strong>. Away from a screen you'll find me at a
      music festival or a Guardians game, hosting a game night, or hiking Hocking Hills. I also say "ope" more than is
      strictly necessary.
    </p>
  </div>

  <div class="about__facts">
    <p class="label">facts, no cap</p>
    <dl class="about__ledger mono">
      {
        facts.map(([k, v]) => (
          <div class="about__row">
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 42.25rem) 20rem;
    gap: var(--s-6) var(--s-16);
    justify-content: start;
    align-items: start;
    padding-block: var(--s-24);
    border-top: 1px solid var(--line);
  }

  .about__label {
    grid-column: 1 / -1;
  }

  .about__text {
    display: grid;
    gap: var(--s-6);
  }

  .about__lede {
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    line-height: 1.3;
    color: var(--w);
    text-wrap: pretty;
  }

  .about__body {
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--g);
    text-wrap: pretty;
  }

  .about__body strong {
    color: var(--w);
    font-weight: 500;
  }

  .about__facts {
    display: grid;
    gap: var(--s-3);
    padding-top: 0.35rem;
  }

  .about__ledger {
    display: grid;
    gap: var(--s-2);
    margin: 0;
  }

  .about__row {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: var(--s-4);
  }

  .about__row dt {
    color: var(--g2);
  }

  .about__row dd {
    margin: 0;
    color: var(--w);
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: 1fr;
      gap: var(--s-8);
      padding-block: var(--s-16);
    }
    .about__facts {
      padding-top: 0;
    }
  }

  @media (max-width: 600px) {
    .about {
      padding-block: var(--s-12);
    }
    .about__lede {
      font-size: var(--text-lg);
    }
    .about__body {
      font-size: var(--text-base);
    }
  }
</style>
