---
import { kitHeadshot } from '~/lib/kit';

const facts = [
  ['coffee', 'chai latte (hot)'],
  ['music', 'metal, electronic'],
  ['movies', 'horror, comedies'],
  ['game', 'legend of zelda: ocarina of time'],
] as const;
---

<section id="about" class="about wrap" aria-labelledby="about-label">
  <div class="about__grid">
    <p id="about-label" class="about__head label">about</p>

    <div class="about__left">
      <figure class="about__stamp">
        <picture>
          <source type="image/webp" srcset={`${kitHeadshot.webp2} 400w, ${kitHeadshot.webp1} 200w`} sizes="(max-width: 800px) 11rem, 20rem" />
          <img src={kitHeadshot.jpg} width="500" height="500" alt="Chris Hartman" loading="lazy" decoding="async" />
        </picture>
      </figure>
      <div class="about__facts">
        <p class="label">fun facts, no cap</p>
        <dl class="about__ledger mono">
          {
            facts.map(([k, v]) => (
              <div class="about__row">
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <div class="about__text">
      <p class="about__lede">
        I'm Chris. I taught myself HTML and CSS by breaking MySpace layouts in 2005 and never really stopped. Over
        fifteen years later I build products for a living and more of them for fun: apps, websites, and lately a lot
        of AI tooling, from northeast Ohio.
      </p>
      <p class="about__body">
        Most of my spare hours go to designing and building products; the ones on the homepage, plus whatever I'm
        taking apart in the homelab that week. I've been working in VR and XR environments a lot lately, enough that
        <strong>spatial computing is the next thing I want to build for</strong>. Away from a screen you'll find me at
        a music festival or a Guardians game, hosting a game night, or hiking Hocking Hills. I also say "ope" more than
        is strictly necessary.
      </p>
    </div>
  </div>
</section>

<style>
  .about {
    position: relative;
    padding-block: var(--s-24);
    border-top: 1px solid var(--line);
    container-type: inline-size;
  }

  .about__grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--s-12);
    align-items: start;
  }

  .about__head {
    grid-column: 1 / -1;
  }

  .about__left {
    display: grid;
    gap: var(--s-6);
    justify-items: start;
  }

  .about__stamp {
    width: min(100%, 20rem);
    aspect-ratio: 1;
    margin: 0;
    background: var(--k2);
    border: 2px solid var(--neon);
    outline: 1px solid var(--line);
    outline-offset: 6px;
    overflow: hidden;
    transform: rotate(-1.5deg);
    transition: transform var(--dur-2) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .about__stamp:hover {
      transform: none;
    }
  }

  :global(html[data-motion='off']) .about__stamp {
    transform: none;
    transition: none;
  }

  .about__stamp img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about__facts {
    display: grid;
    gap: var(--s-3);
    width: min(100%, 20rem);
  }

  .about__ledger {
    display: grid;
    gap: var(--s-2);
    margin: 0;
  }

  .about__row {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: var(--s-4);
  }

  .about__row dt {
    color: var(--g2);
  }

  .about__row dd {
    margin: 0;
    color: var(--w);
  }

  .about__text {
    display: grid;
    gap: var(--s-6);
    max-width: 42.25rem;
  }

  .about__lede {
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    line-height: 1.3;
    color: var(--w);
    text-wrap: pretty;
  }

  .about__body {
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--g);
    text-wrap: pretty;
  }

  .about__body strong {
    color: var(--w);
    font-weight: 500;
  }

  @media (max-width: 800px) {
    .about {
      padding-block: var(--s-12);
    }
    .about__grid {
      grid-template-columns: 1fr;
      gap: var(--s-8);
    }
    .about__stamp {
      width: 11rem;
    }
    .about__facts {
      width: 100%;
    }
    .about__lede {
      font-size: var(--text-lg);
    }
    .about__body {
      font-size: var(--text-base);
    }
  }
</style>
