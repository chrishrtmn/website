---
import Section from './Section.astro';
import { kitHeadshot } from '~/lib/kit';

const facts = [
  ['coffee', 'chai latte (hot)'],
  ['music', 'metal, electronic'],
  ['movies', 'horror, comedy'],
  ['game', 'legend of zelda: ocarina of time'],
] as const;
---

<Section id="about" label="about" title="Facts, no cap">
  <div class="about__card">
    <figure class="about__stamp">
      <picture>
        <source type="image/webp" srcset={`${kitHeadshot.webp2} 400w, ${kitHeadshot.webp1} 200w`} sizes="(max-width: 600px) 5.5rem, 9rem" />
        <img src={kitHeadshot.jpg} width="500" height="500" alt="Chris Hartman" loading="lazy" decoding="async" />
      </picture>
    </figure>
    <dl class="about__ledger mono">
      {
        facts.map(([k, v]) => (
          <div class="about__row">
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="about__text">
    <p class="about__lede">
      I'm Chris. I taught myself HTML and CSS by breaking MySpace layouts in 2005 and never really stopped. Over
      fifteen years later I build products for a living and more of them for fun: apps, websites, and lately a lot of
      AI tooling, from northeast Ohio.
    </p>
    <p class="about__body">
      Most of my spare hours go to designing and building products; the ones on the homepage, plus whatever I'm taking
      apart in the homelab that week. I've been working in VR and XR environments a lot lately, enough that
      <strong>spatial computing is the next thing I want to build for</strong>. Away from a screen you'll find me at a
      music festival or a Guardians game, hosting a game night, or hiking Hocking Hills. I also say "ope" more than is
      strictly necessary.
    </p>
  </div>
</Section>

<style>
  .about__card {
    display: flex;
    align-items: center;
    gap: var(--s-8);
    margin: var(--s-2) 0 var(--s-12);
  }

  .about__stamp {
    flex: none;
    width: 9rem;
    aspect-ratio: 1;
    margin: 0;
    border: 2px solid var(--neon);
    outline: 1px solid var(--line);
    outline-offset: 6px;
    overflow: hidden;
    background: var(--k2);
  }

  .about__stamp img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about__text {
    display: grid;
    gap: var(--s-6);
    max-width: var(--measure);
  }

  .about__lede {
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    line-height: 1.3;
    color: var(--w);
    text-wrap: pretty;
  }

  .about__body {
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--g);
    text-wrap: pretty;
  }

  .about__body strong {
    color: var(--w);
    font-weight: 500;
  }

  .about__ledger {
    display: grid;
    gap: var(--s-2);
    margin: 0;
    width: min(100%, 26rem);
  }

  .about__row {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: var(--s-4);
  }

  .about__row dt {
    color: var(--g2);
  }

  .about__row dd {
    margin: 0;
    color: var(--w);
  }

  @media (max-width: 600px) {
    .about__lede {
      font-size: var(--text-lg);
    }
    .about__body {
      font-size: var(--text-base);
    }
    .about__card {
      align-items: flex-start;
      gap: var(--s-6);
      margin-bottom: var(--s-8);
    }
    .about__stamp {
      width: 5.5rem;
      outline-offset: 4px;
    }
    .about__row {
      grid-template-columns: 3.5rem 1fr;
      gap: var(--s-3);
    }
  }
</style>
