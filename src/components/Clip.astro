---
interface Props {
  name: string;
  caption: string;
  width: number;
  height: number;
  phone?: boolean;
}

const { name, caption, width, height, phone = false } = Astro.props;
const base = `/posts/rebuild/${name}`;
---

<figure class:list={['clip', { 'clip--phone': phone }]} style={`--clip-max: ${width / 2}px`}>
  <video width={width} height={height} poster={`${base}.jpg`} muted loop playsinline preload="none" aria-label={caption} data-clip>
    <source src={`${base}.webm`} type="video/webm" />
    <source src={`${base}.mp4`} type="video/mp4" />
  </video>
  <figcaption>{caption}</figcaption>
</figure>

<script>
  // play while on screen and motion is on; a poster otherwise
  const clips = [...document.querySelectorAll<HTMLVideoElement>('[data-clip]')];
  if (clips.length) {
    const root = document.documentElement;
    const motionOn = () => root.dataset.motion !== 'off';
    const inView = new WeakSet<HTMLVideoElement>();
    const counted = new WeakSet<HTMLVideoElement>();
    const va = () => (window as { va?: (t: 'event', e: { name: string; data?: object }) => void }).va;
    clips.forEach((v) =>
      v.addEventListener('playing', () => {
        if (counted.has(v)) return;
        counted.add(v);
        va()?.('event', { name: 'post-clip-play', data: { clip: v.closest('figure')?.querySelector('source')?.getAttribute('src')?.split('/').pop()?.replace(/\.\w+$/, '') ?? '' } });
      }),
    );
    const sync = (v: HTMLVideoElement) => {
      if (inView.has(v) && motionOn()) v.play().catch(() => {});
      else v.pause();
    };
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) inView.add(v);
          else inView.delete(v);
          sync(v);
        }
      },
      { threshold: 0.4 },
    );
    clips.forEach((v) => io.observe(v));
    new MutationObserver(() => clips.forEach(sync)).observe(root, { attributes: true, attributeFilter: ['data-motion'] });
  }
</script>

<style>
  .clip {
    margin: var(--s-8) 0;
  }

  /* never wider than the recording at 2x, so small close-ups stay crisp instead of stretching */
  .clip video {
    width: 100%;
    max-width: var(--clip-max);
  }

  .clip--phone video {
    width: min(100%, 20rem);
  }
</style>
