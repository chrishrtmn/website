---
import { profileSong, top8 } from '~/content/top8';
---

<dialog class="tray top8" id="top8-tray" aria-labelledby="top8-title" data-top8>
  <div class="tray__panel">
    <header class="tray__head">
      <p class="label">top 8</p>
      <h2 id="top8-title" class="tray__title">Chris's Top 8</h2>
      <div class="tray__tools small">
        <button type="button" class="tray__close" data-tray-close aria-label="Close">esc</button>
      </div>
    </header>
    <div class="tray__body">
      <p class="top8__sub">You found the cheat code. Here's the MySpace bit.</p>
      <div class="top8__song" aria-label="Profile song">
        <span class="top8__song-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span class="top8__song-label label">profile song</span>
        <span class="top8__song-title">
          {
            profileSong ? (
              profileSong.url ? (
                <a href={profileSong.url} target="_blank" rel="noopener">
                  {profileSong.title} · {profileSong.artist}
                </a>
              ) : (
                `${profileSong.title} · ${profileSong.artist}`
              )
            ) : (
              'tbd'
            )
          }
        </span>
      </div>
      <ol class="top8__grid">
        {
          top8.map((e, i) => (
            <li class:list={['top8__cell', { 'top8__cell--tbd': e.placeholder }]} style={`--i: ${i}`}>
              {e.placeholder ? (
                <span class="top8__ghost" aria-label="To be decided">
                  <svg viewBox="0 0 64 64" aria-hidden="true">
                    <circle cx="32" cy="22" r="12" />
                    <path d="M8 60c0-14 10.7-22 24-22s24 8 24 22" />
                  </svg>
                  <span class="top8__note">tbd</span>
                </span>
              ) : e.url ? (
                <a href={e.url} target="_blank" rel="noopener">
                  <span class="top8__name">{e.name}</span>
                  <span class="top8__note">{e.note}</span>
                </a>
              ) : (
                <span>
                  <span class="top8__name">{e.name}</span>
                  <span class="top8__note">{e.note}</span>
                </span>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</dialog>

<script>
  import { UNLOCK_EVENT } from '~/content/top8';

  const tray = document.getElementById('top8-tray') as HTMLDialogElement | null;
  let lastFocus: HTMLElement | null = null;

  function openTray() {
    if (!tray || tray.open) return;
    lastFocus = document.activeElement as HTMLElement;
    tray.showModal();
    document.body.style.overflow = 'hidden';
    tray.classList.remove('is-in');
    void tray.offsetWidth;
    tray.classList.add('is-in');
    tray.querySelector<HTMLElement>('[data-tray-close]')?.focus();
  }

  function closeTray() {
    if (tray?.open) tray.close();
  }

  tray?.addEventListener('close', () => {
    document.body.style.overflow = '';
    lastFocus?.focus();
  });
  tray?.addEventListener('click', (e) => {
    if (e.target === tray) closeTray();
  });
  tray?.querySelector('[data-tray-close]')?.addEventListener('click', closeTray);
  document.addEventListener(UNLOCK_EVENT, () => setTimeout(openTray, 50));
</script>

<style>
  .tray {
    position: fixed;
    inset: auto 0 0 0;
    width: 100%;
    max-width: none;
    max-height: 88dvh;
    margin: 0;
    padding: 0;
    border: 0;
    border-top: 1px solid var(--line);
    border-radius: 14px 14px 0 0;
    background: var(--k);
    color: var(--w);
    overflow: hidden;
  }

  .tray::backdrop {
    background: rgba(0, 0, 0, 0.6);
  }

  .tray__panel {
    display: grid;
    grid-template-rows: auto 1fr;
    max-height: 88dvh;
  }

  .tray__head {
    position: sticky;
    top: 0;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    column-gap: var(--s-6);
    row-gap: var(--s-1);
    padding: var(--s-6) var(--gutter) var(--s-4);
    background: var(--k);
    border-bottom: 1px solid var(--line);
  }

  .tray__title {
    font-size: var(--text-2xl);
  }

  .tray__tools {
    grid-column: 2;
    grid-row: 1 / 3;
    align-self: start;
  }

  .tray__close {
    padding: 0.25em 0.7em;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--g);
    font: inherit;
  }

  .tray__close:hover,
  .tray__close:focus-visible {
    color: var(--neon);
    border-color: var(--neon);
  }

  .tray__body {
    padding: var(--s-8) var(--gutter) var(--s-12);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .top8__sub {
    margin-bottom: var(--s-4);
    color: var(--g);
  }

  .top8__song {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    margin-bottom: var(--s-8);
    padding: var(--s-2) var(--s-4) var(--s-2) var(--s-3);
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--k2);
    font-size: var(--text-sm);
  }

  .top8__song-bars {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 0.9rem;
  }

  .top8__song-bars i {
    width: 3px;
    height: 30%;
    background: var(--neon);
    transform-origin: bottom;
  }

  .top8__song-bars i:nth-child(2) {
    height: 70%;
  }
  .top8__song-bars i:nth-child(3) {
    height: 50%;
  }
  .top8__song-bars i:nth-child(4) {
    height: 90%;
  }

  :global(html[data-motion='on']) .tray[open] .top8__song-bars i {
    animation: bars 1.1s var(--ease-in-out) infinite alternate;
    animation-delay: calc(var(--i, 0) * 0s);
  }
  :global(html[data-motion='on']) .tray[open] .top8__song-bars i:nth-child(2) {
    animation-delay: -0.3s;
  }
  :global(html[data-motion='on']) .tray[open] .top8__song-bars i:nth-child(3) {
    animation-delay: -0.6s;
  }
  :global(html[data-motion='on']) .tray[open] .top8__song-bars i:nth-child(4) {
    animation-delay: -0.9s;
  }

  @keyframes bars {
    from {
      transform: scaleY(0.35);
    }
    to {
      transform: scaleY(1);
    }
  }

  .top8__song-title {
    color: var(--w);
  }

  .top8__song-title a {
    color: inherit;
    text-decoration: none;
  }

  .top8__song-title a:hover,
  .top8__song-title a:focus-visible {
    color: var(--neon);
  }

  .top8__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--s-3);
    max-width: 64rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: top8;
  }

  .top8__cell {
    counter-increment: top8;
    border: 1px solid var(--neon);
    background: var(--k2);
  }

  .top8__cell > * {
    display: grid;
    gap: var(--s-1);
    padding: var(--s-4);
    aspect-ratio: 4 / 3;
    min-height: 8rem;
    align-content: end;
    color: var(--w);
    text-decoration: none;
  }

  .top8__cell > *::before {
    content: counter(top8);
    justify-self: start;
    margin-bottom: auto;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--neon);
  }

  .top8__cell a:hover,
  .top8__cell a:focus-visible {
    background: var(--neon);
    color: var(--neon-ink);
  }

  .top8__cell a:hover::before,
  .top8__cell a:focus-visible::before,
  .top8__cell a:hover .top8__note,
  .top8__cell a:focus-visible .top8__note {
    color: var(--neon-ink);
  }

  .top8__name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-tight);
    line-height: 1.1;
  }

  .top8__note {
    font-size: var(--text-sm);
    color: var(--g);
  }

  .top8__cell--tbd {
    border-style: dashed;
    border-color: var(--neon-dim);
  }

  .top8__ghost {
    align-content: space-between;
    justify-items: center;
  }

  .top8__ghost::before {
    justify-self: start;
    color: var(--neon-dim);
  }

  .top8__ghost svg {
    width: 40%;
    max-width: 4rem;
    fill: var(--neon-dim);
    opacity: 0.6;
  }

  .top8__ghost .top8__note {
    color: var(--g2);
  }

  /* motion on: sheet slides up, cells stagger in */
  :global(html[data-motion='on']) .tray[open] {
    animation: tray-in 400ms var(--ease-out) both;
  }

  :global(html[data-motion='on']) .tray[open]::backdrop {
    animation: fade 250ms var(--ease-out) both;
  }

  :global(html[data-motion='on']) .tray.is-in .top8__cell {
    animation: cell-in var(--dur-3) var(--ease-out) calc(300ms + var(--i) * 50ms) both;
  }

  @keyframes tray-in {
    from {
      transform: translateY(100%);
    }
    to {
      transform: none;
    }
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  @keyframes cell-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 800px) {
    .top8__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .top8__cell > * {
      min-height: 6.5rem;
    }
  }
</style>
