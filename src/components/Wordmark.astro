---
import { site } from '~/lib/site';

interface Props {
  href?: string;
}
const { href = '/' } = Astro.props;
---

<a class="wm mono" href={href} aria-label={`${site.handle}, home`} title="Right-click for the paparazzi kit" data-logo>
  <span class="wm__half" aria-hidden="true">chrish<span class="wm__slash" style="--phase: 0s"></span></span><span class="wm__half" aria-hidden="true">rtm<span class="wm__slash" style="--phase: 4.2s"></span>n</span>
</a>

<style>
  .wm {
    display: inline-block;
    color: var(--w);
    text-decoration: none;
    line-height: 1.1;
    transition: color var(--dur-1) var(--ease-out);
  }

  .wm__half {
    display: inline-block;
    white-space: nowrap;
  }

  .wm__slash {
    display: inline-block;
    width: 1ch;
    text-align: center;
    color: var(--neon);
    transition: color var(--dur-1) var(--ease-out);
  }

  /* hover: the name and the slashes swap colours */
  @media (hover: hover) and (pointer: fine) {
    .wm:hover {
      color: var(--neon);
    }
    .wm:hover .wm__slash {
      color: var(--w);
    }
  }

  .wm:focus-visible {
    color: var(--neon);
  }

  .wm:focus-visible .wm__slash {
    color: var(--w);
  }

  .wm__slash::before {
    content: '/';
  }

  /* idle glitch: each slash flickers through cursor-ish glyphs for ~600ms every 9s, offset by --phase */
  :global(html[data-motion='on']) .wm__slash::before {
    animation: glyphs 9s steps(1, end) var(--phase) infinite;
  }

  /* hover and focus run the same glitch once, right away, the second slash a beat behind the first */
  :global(html[data-motion='on']) .wm:hover .wm__slash::before,
  :global(html[data-motion='on']) .wm:focus-visible .wm__slash::before {
    animation: glyphs-once 600ms steps(1, end) both;
  }

  :global(html[data-motion='on']) .wm:hover .wm__half + .wm__half .wm__slash::before,
  :global(html[data-motion='on']) .wm:focus-visible .wm__half + .wm__half .wm__slash::before {
    animation-delay: 90ms;
  }

  @keyframes glyphs {
    0%,
    93% {
      content: '/';
    }
    93.5% {
      content: '_';
    }
    94.5% {
      content: '▌';
    }
    95.5% {
      content: 'a';
    }
    96.5% {
      content: '|';
    }
    97.5% {
      content: '>';
    }
    98.5% {
      content: '_';
    }
    99.3%,
    100% {
      content: '/';
    }
  }

  /* the idle sequence, compressed into one pass */
  @keyframes glyphs-once {
    0% {
      content: '_';
    }
    12% {
      content: '▌';
    }
    28% {
      content: 'a';
    }
    44% {
      content: '|';
    }
    60% {
      content: '>';
    }
    76% {
      content: '_';
    }
    92%,
    100% {
      content: '/';
    }
  }
</style>
