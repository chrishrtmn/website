---
import { site } from '~/lib/site';
---

<dialog class="sheet tray privacy" id="privacy-tray" aria-labelledby="privacy-title">
  <div class="tray__panel">
    <div class="sheet__grab" data-sheet-grab>
      <span class="sheet__handle" aria-hidden="true"></span>
      <button type="button" class="visually-hidden" data-sheet-close>Close</button>
    </div>
    <header class="tray__head" data-sheet-drag>
      <p class="label">privacy</p>
      <h2 id="privacy-title" class="tray__title">Nothing to see here</h2>
      <div class="tray__tools small">
        <button type="button" class="tray__close" data-sheet-close aria-label="Close, esc">esc</button>
      </div>
    </header>
    <div class="tray__body privacy__body">
      <p>
        No cookies, no ads, no trackers following you around. Visits are counted with Umami, which records the page,
        where you came from, and your browser, device type, screen size and country. Nothing that identifies you is
        stored, and visits can't be tied together across days.
      </p>
      <p>
        If your browser sends Do Not Track or Global Privacy Control, the counter never loads. You can also switch it
        off here; the choice is kept in this browser.
      </p>
      <p class="privacy__switch">
        <span>Count my visits: <b data-privacy-state>on</b></span>
        <button type="button" class="privacy__toggle small" data-privacy-toggle>switch off</button>
      </p>
      <p class="privacy__small small">
        Questions or a request about your data: <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
    </div>
  </div>
</dialog>

<script>
  import { sheet } from '~/lib/sheet';

  const el = document.getElementById('privacy-tray') as HTMLDialogElement | null;
  if (el) {
    const tray = sheet(el, { focus: '.tray__close' });
    const state = el.querySelector<HTMLElement>('[data-privacy-state]');
    const toggle = el.querySelector<HTMLButtonElement>('[data-privacy-toggle]');
    const signal = () => {
      const n = navigator as Navigator & { globalPrivacyControl?: boolean };
      return n.doNotTrack === '1' || n.globalPrivacyControl === true;
    };
    const optedOut = () => {
      try {
        return localStorage.getItem('umami.disabled') === '1';
      } catch {
        return false;
      }
    };
    const render = () => {
      if (!state || !toggle) return;
      if (signal()) {
        state.textContent = 'off (your browser asked)';
        toggle.hidden = true;
        return;
      }
      const off = optedOut();
      state.textContent = off ? 'off' : 'on';
      toggle.textContent = off ? 'switch on' : 'switch off';
      toggle.setAttribute('aria-pressed', String(off));
    };
    toggle?.addEventListener('click', () => {
      try {
        if (optedOut()) localStorage.removeItem('umami.disabled');
        else localStorage.setItem('umami.disabled', '1');
      } catch {}
      render();
    });
    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-privacy-link]');
      if (!a) return;
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button === 1) return;
      e.preventDefault();
      render();
      tray.open();
    });
    render();
  }
</script>

<style>
  /* same tray chrome as the paparazzi kit; those styles are scoped to KitTray, so they're repeated here */
  .tray__panel {
    position: relative;
    display: grid;
    grid-template-rows: auto auto 1fr;
    max-height: 88dvh;
  }

  .tray__head {
    position: sticky;
    top: 0;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    column-gap: var(--s-6);
    row-gap: var(--s-1);
    padding: var(--s-6) var(--gutter) var(--s-4);
    background: var(--k);
    border-bottom: 1px solid var(--line);
  }

  .tray__title {
    font-size: var(--text-2xl);
  }

  .tray__tools {
    grid-column: 2;
    grid-row: 1 / 3;
    display: flex;
    gap: var(--s-3);
    align-self: start;
  }

  .tray__close {
    padding: 0.25em 0.7em;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--g);
    font: inherit;
  }

  .tray__close:hover {
    color: var(--neon);
    border-color: var(--neon);
  }

  .tray__body {
    padding: var(--s-8) var(--gutter) var(--s-12);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .privacy__body {
    display: grid;
    gap: var(--s-4);
    max-width: 44rem;
    color: var(--g);
  }

  .privacy__body p {
    margin: 0;
  }

  .privacy__switch {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-4);
    color: var(--w);
  }

  .privacy__switch b {
    color: var(--neon);
    font-weight: 500;
  }

  .privacy__toggle {
    padding: 0.25em 0.8em;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--g);
    font: inherit;
    transition: color var(--dur-1) var(--ease-out), border-color var(--dur-1) var(--ease-out);
  }

  .privacy__toggle:hover,
  .privacy__toggle:focus-visible {
    color: var(--neon);
    border-color: var(--neon);
  }

  .privacy__small a {
    color: var(--w);
  }
</style>
